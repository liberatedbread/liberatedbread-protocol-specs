    "manufacturer": "Seeblue / LEDGlow",
    "manufacturer_status": "active",
    "name": "Seeblue Motorcycle LED Controller",
    "notes": "White-label BLE module used by LEDGlow Motorcycle, LEDGlow V2, and other Seeblue-powered brands. SEEBlue transport envelope: [0x95, len, index, protocol_id, data..., checksum]. Checksum is 8-bit two's complement over bytes from message_length through last payload byte. Static analysis sources: com.seeblue.ledglow_moto v1.9.1 and com.seeblue.ledglowv2 v1.4.1.\n",
    "protocol": "ble",
    "setup": {
      "confidence": "medium",
      "credentials": {
        "issued_to_client": [],
        "notes": "Anything within radio range can connect and issue commands. Physical proximity is the only access control. Note the app-level handshake on protocol 0x00 after every connect (see setup description); whether the firmware enforces it is unverified.\n",
        "stored_on_device": [],
        "wifi_passphrase_protection": "not_applicable"
      },
      "factory_reset": {
        "confidence": "low",
        "effect": "No credential state to clear. Power-cycling drops the current connection, which is the actual remedy for the common failure mode: the device already being connected to another central.\n",
        "procedures": [
          {
            "name": "Power cycle",
            "steps": [
              {
                "action": "Remove power (or battery) for a few seconds and reapply.",
                "actor": "user",
                "expect": "Device advertises again and accepts a new connection."
              }
            ]
          }
        ]
      },
      "methods": [
        {
          "ble": {
            "pairing_required": false
          },
          "description": "No provisioning step: the device advertises as soon as it is powered on and accepts a connection from any central. There is no account, no network credential exchange and no pairing PIN. One caveat: after every connect the vendor app runs an app-level handshake on SEEBlue protocol 0x00 — a 7-byte message [0x00 + the last 6 bytes of the phone's ANDROID_ID]. Whether the firmware rejects writes without it is unverifiable from app code, so a \"just write\" client may or may not work; implement the handshake to be safe.\n",
          "steps": [
            {
              "action": "Power the device and scan for its advertisement.",
              "actor": "client",
              "request": {
                "protocol": "ble_gatt"
              }
            },
            {
              "action": "Connect, then send the post-connect handshake on protocol 0x00: 7-byte message [0x00 + last 6 bytes of ANDROID_ID].",
              "actor": "client"
            }
          ],
          "type": "ble_direct",
          "verified": false
        }
      ],
      "notes": "No provisioning. Discovery is by exact advertised local name — \"LEDGlowMoto\" or \"LEDGlowV2\"; the controllers do advertise a stable local name and that name is the discovery key.\n",
      "rejoin": {
        "in_place_supported": true,
        "notes": "Nothing binds this device to a network or an owner, so switching controllers is just connecting from the new one. If the old client is an Android or iOS phone, remove the device from the OS Bluetooth list as well — a cached bond can keep the phone reconnecting automatically and holding the single available link.\n",
        "requires_factory_reset": false
      },
      "required": false
    }
  },
