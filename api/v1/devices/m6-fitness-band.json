    "manufacturer": "Unknown (AliExpress generic / Mi Band clone)",
    "manufacturer_status": "active",
    "name": "M6 Smart Fitness Band",
    "notes": "The M6 Smart Fitness Band is a ~$6 Mi Band clone sold on AliExpress. Hardware uses Telink TLSR8232 SoC with ST7735 OLED display, PPG heart rate sensor, and vibration motor. The companion app is unconfirmed; com.veryfit.multi (Veryfit 2.0) is a plausible generic fitness app.\nThe Veryfit 2.0 app uses a single custom 128-bit BLE service multiplexing all device functions through four characteristics (normal write/notify and health write/notify). Commands are 20-byte fixed-length frames with a command ID at byte 0 and a sub-command key at byte 1.\nBLE connection flow: scan for service 00000AF0, connect, enable notifications on NOTIFY_UUID_NORMAL and NOTIFY_UUID_HEALTH, then send commands on WRITE_UUID_NORMAL / WRITE_UUID_HEALTH.\nResearch status: APK acquired, decompiled to smali. All UUIDs and command IDs recovered. Byte-level payload formats are inferred from smali field layouts and health data parser logic — HCI snoop needed to confirm exact payload encoding.\n",
    "protocol": "ble",
    "setup": {
      "confidence": "low",
      "credentials": {
        "issued_to_client": [],
        "notes": "BLE-only; no WiFi passphrase crosses the link. No authentication of any kind was found, so health data is readable by anyone in range.\n",
        "stored_on_device": [],
        "wifi_passphrase_protection": "not_applicable"
      },
      "factory_reset": {
        "applicable": "unknown",
        "confidence": "low",
        "effect": "Not established. The recovered command set is believed to include a reset, but which command ID carries it has not been confirmed, and issuing an unverified ID to a device with a firmware-update path is a good way to brick a band. Not stated rather than guessed.\n"
      },
      "methods": [
        {
          "ble": {
            "pairing_required": false
          },
          "description": "Connect over GATT, enable notifications on the normal and health notify characteristics, then write 20-byte command frames.\n",
          "steps": [
            {
              "action": "Wake the band by pressing its touch button so it advertises.",
              "actor": "user"
            },
            {
              "action": "Scan for service 00000AF0 and connect over GATT.",
              "actor": "client"
            },
            {
              "action": "Enable notifications on NOTIFY_UUID_NORMAL and NOTIFY_UUID_HEALTH.",
              "actor": "client"
            },
            {
              "action": "Write 20-byte command frames to WRITE_UUID_NORMAL or WRITE_UUID_HEALTH, command ID at byte 0, sub-command at byte 1.\n",
              "actor": "client",
              "expect": "A response frame arrives on the matching notify characteristic."
            }
          ],
          "type": "ble_direct",
          "verified": false
        }
      ],
      "notes": "The band needs no provisioning. It advertises service 00000AF0 and accepts commands from any client that connects; the Veryfit app pairs no keys and binds the band to no account.\nConfidence is low throughout: the companion app itself is unconfirmed (com.veryfit.multi is a plausible match, not an established one), and the payload encoding is inferred from smali rather than observed on the wire.\n",
      "rejoin": {
        "in_place_supported": true,
        "notes": "The band joins no network. Any client may connect once the previous one disconnects.\n",
        "requires_factory_reset": false
      },
      "required": false
    }
  },
