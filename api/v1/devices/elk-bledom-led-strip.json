          "ble": {
            "pairing_required": false
          },
          "description": "Scan for 0xFFF0 service UUID, connect, and write 9-byte packets to characteristic 0xFFF3. Classic devices need no initialization sequence; newer MELK-*/MODELX firmware disconnects unless a login handshake (7e 07 83, then 7e 04 04, about 1 s apart) is written immediately after connect.\n",
          "steps": [
            {
              "action": "Power the LED strip controller.",
              "actor": "user",
              "request": {
                "protocol": "ble_gatt"
              }
            },
            {
              "action": "Scan for the 0xFFF0 service UUID (ignore HID 0x1812) and connect.\n",
              "actor": "client"
            },
            {
              "action": "Write 9-byte command packets to characteristic 0xFFF3.\n",
              "actor": "client"
            }
          ],
          "type": "ble_direct",
          "verified": false
        }
      ],
      "notes": "No provisioning. Device advertises when powered. No bonding or pairing required and no authentication. Not write-only: state notifications arrive on 0xFFF4 — subscribe to it for feedback.\n",
      "rejoin": {
        "in_place_supported": true,
        "notes": "No bonding. Any central within range can connect and write.\n",
        "requires_factory_reset": false
      },
      "required": false
    },
