{
  "device": {
    "category": "automotive",
    "manufacturer": "SAE International",
    "manufacturer_status": "active",
    "model": "Modes 01-0A (all legislated OBD-II services)",
    "name": "OBD-II PID Reference (SAE J1979)",
    "notes": "Complete reference for all legislated (emissions-related) OBD-II Parameter IDs.\nModes 01-0A per SAE J1979 / ISO 15031-5. This is a REFERENCE spec — not a device.\nEvery OBD2 vehicle target in this repo leans on these PIDs when its own\nmanufacturer-specific functions are unknown.\n\nAll Mode 01 PIDs return data starting at byte 2 (bytes 0-1 are the mode/PID echo).\nFormula: value = (A * 256 + B) unless noted. Standard J1979 PIDs extend through\n~0xC8 per J1979-DA (EGT 78/79, DPF temperature 7C, NOx sensors, CARB-mandated\nodometer A6 from MY2019, …); this table covers the legislated core through 0x5C.\nBit-encoded PIDs list their bit layout.\n\nJ1979 family restructure: J1979_201702 was superseded by J1979-2_202104\n(OBDonUDS) and J1979-3 (ZEVonUDS); a consolidated J1979_202505 was published\n2025-05-23.\n\nMODES:\n- Mode 01: Request current powertrain diagnostic data\n- Mode 02: Request freeze frame data (same PIDs as 01)\n- Mode 03: Request emission-related DTCs\n- Mode 04: Clear/reset emission-related diagnostic information\n- Mode 05: Request oxygen sensor monitoring test results (non-CAN only — on ISO 15765-4 vehicles O2 monitoring is Mode 06)\n- Mode 06: Request on-board monitoring test results for specific monitored systems\n- Mode 07: Request emission-related DTCs detected during current/last driving cycle\n- Mode 08: Request control of on-board system, test, or component\n- Mode 09: Request vehicle information\n- Mode 0A: Request emission-related DTCs with permanent status\n",
    "protocol": "obd2",
    "transport": "obd2",
    "type": "reference-diagnostic-protocol"
  },
  "modes": [
    {
      "description": "Live sensor data from the engine and emissions systems",
      "name": "Current Powertrain Data",
      "number": "01",
      "pids": [
        {
          "bytes": 4,
          "description": "Bit-encoded. Bit 7 of byte A = PID 01 supported, bit 6 = PID 02, etc.",
          "formula": "bitmask",
          "name": "PIDs supported [01-20]",
          "pid": "00"
        },
        {
          "bytes": 4,
          "description": "Bit-encoded MIL, DTC count, monitor completion status",
          "formula": "bitmask",
          "name": "Monitor status since DTCs cleared",
          "pid": "01"
        },
        {
          "bytes": 2,
          "description": "DTC that triggered the freeze frame",
          "formula": "dtc_decode",
          "name": "Freeze frame DTC",
          "pid": "02"
        },
        {
          "bytes": 2,
          "formula": "byte_A=bank1_mode byte_B=bank2_mode",
          "name": "Fuel system status",
          "pid": "03",
          "values": {
            "1": "Open loop — insufficient engine temperature",
            "16": "Closed loop — but fault in feedback system",
            "2": "Closed loop — using oxygen sensor feedback",
            "4": "Open loop — engine load OR deceleration fuel cut-off",
            "8": "Open loop — system failure"
          }
        },
        {
          "bytes": 1,
          "formula": "A * 100 / 255",
          "name": "Calculated engine load",
          "pid": "04",
          "range": [
            0,
            100
          ],
          "unit": "%"
        },
        {
          "bytes": 1,
          "formula": "A - 40",
          "name": "Engine coolant temperature",
          "pid": "05",
          "range": [
            -40,
            215
          ],
          "unit": "°C"
        },
        {
          "bytes": 1,
          "formula": "(A - 128) * 100 / 128",
          "name": "Short term fuel trim — Bank 1",
          "pid": "06",
          "range": [
            -100,
            99.2
