    {
      "description": "Returns stored diagnostic trouble codes",
      "name": "Request Emission-Related DTCs",
      "number": "03",
      "response_format": [
        {
          "byte": 0,
          "name": "mode_echo",
          "value": "43"
        },
        {
          "byte": 1,
          "description": "Number of DTCs",
          "name": "dtc_count"
        },
        {
          "byte": 2,
          "description": "Each DTC = 2 bytes encoding a 5-character code. Byte 1 bits 7-6 = first char (0=P, 1=C, 2=B, 3=U), bits 5-4 = second char (0-3); the remaining 12 bits are chars 3-5 as 3 hex digits (byte 1 low nibble = char 3, byte 2 = chars 4-5).",
          "name": "dtc_data",
          "repeat": true
        }
      ]
    },
    {
      "caution": "Also resets readiness monitors — will not pass inspection until monitors complete",
      "description": "Clears DTCs, freeze frame, oxygen sensor test data, and monitor status",
      "name": "Clear/Reset Emission-Related Diagnostic Information",
      "number": "04",
      "response": "Mode 04 echo: \"44\" — no data payload (echo, no data)"
    },
