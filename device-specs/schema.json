{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengreeniot.pigscanfly.ca/device-spec.schema.json",
  "title": "OpenGreenIoT Device Spec",
  "description": "Schema for OpenGreenIoT BLE device specification files.",
  "type": "object",
  "required": ["device", "services"],
  "properties": {
    "device": {
      "type": "object",
      "required": ["name", "manufacturer", "manufacturer_status", "protocol"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable device name."
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "description": "Original device manufacturer."
        },
        "manufacturer_status": {
          "type": "string",
          "enum": ["abandoned", "shutdown", "unsupported"],
          "description": "Why this device needs open source rescue."
        },
        "protocol": {
          "type": "string",
          "enum": ["ble", "wifi", "zigbee", "zwave"],
          "description": "Primary communication protocol."
        },
        "notes": {
          "type": "string",
          "description": "Optional notes about the device."
        },
        "identification": {
          "type": "object",
          "description": "How to identify this device during scanning.",
          "properties": {
            "local_name_prefix": {
              "type": "string",
              "description": "BLE advertisement local name prefix."
            },
            "service_uuids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "description": "BLE service UUIDs advertised by the device."
            }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uuid", "name", "characteristics"],
        "properties": {
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "BLE service UUID."
          },
          "name": {
            "type": "string",
            "description": "Human-readable service name."
          },
          "characteristics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["uuid", "name", "properties"],
              "properties": {
                "uuid": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                  "description": "BLE characteristic UUID."
                },
                "name": {
                  "type": "string",
                  "description": "Human-readable characteristic name."
                },
                "properties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["read", "write", "write_without_response", "notify", "indicate"]
                  },
                  "description": "BLE characteristic properties."
                },
                "commands": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": ["description"],
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "value": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        },
                        "description": "Fixed byte sequence for this command."
                      },
                      "template": {
                        "type": "array",
                        "description": "Parameterized byte sequence. Strings are parameter references."
                      },
                      "parameters": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "required": ["type"],
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": ["uint8", "uint16", "int8", "int16", "bytes", "string"]
                            },
                            "min": {
                              "type": "integer"
                            },
                            "max": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "format": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["offset", "length", "name", "type"],
                    "properties": {
                      "offset": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "length": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": ["bool", "uint8", "uint16", "int8", "int16", "bytes", "string"]
                      }
                    }
                  },
                  "description": "Binary format of readable/notifiable characteristic values."
                }
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "name"],
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["light", "switch", "sensor", "binary_sensor", "fan", "cover", "climate"],
            "description": "Home Assistant entity platform."
          },
          "name": {
            "type": "string"
          },
          "device_class": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state_characteristic": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "state_mapping": {
            "type": "object"
          },
          "commands": {
            "type": "object"
          }
        }
      }
    }
  }
}
