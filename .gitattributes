# device-specs/index.json is machine-written (scripts/generate_index.py) and
# committed by CI's publish-index job, never by hand. Marking it generated
# collapses it in GitHub's diff view, so a reviewer looking at a spec PR that
# happened to pick it up in a merge sees the specs rather than 60 kB of JSON.
device-specs/index.json linguist-generated=true

# Instruction glyphs (glyphs/) are tracked with Git LFS. They are binary-ish
# assets that specs reference by path, they will accumulate one or more per
# device across ~200 devices, and unlike a spec nobody reviews them by reading
# the file — a glyph is reviewed by looking at it. Keeping them out of the
# object store keeps a clone of the specs cheap for the consumers that vendor
# this repo as a subtree and want the YAML, not the artwork.
#
# Note the trade-off on `*.svg`: SVG is text, so LFS costs it a readable diff
# and requires git-lfs to be installed before the working copy shows anything
# but a pointer. It is tracked anyway so the whole set lives in one place under
# one rule; drop the svg line if reviewable diffs turn out to matter more.
glyphs/**/*.svg filter=lfs diff=lfs merge=lfs -text
glyphs/**/*.png filter=lfs diff=lfs merge=lfs -text
glyphs/**/*.webp filter=lfs diff=lfs merge=lfs -text
