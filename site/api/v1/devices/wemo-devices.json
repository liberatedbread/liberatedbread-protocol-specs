  "http_endpoints": [
    {
      "description": "PRIMARY Wemo identification endpoint. Fetch the LOCATION URL returned by SSDP discovery. Parse deviceType for variant matching, UDN/serial/MAC for stable identity and ordering, friendlyName for display naming, and serviceList for per-device controlURL and eventSubURL values.\n",
      "method": "GET",
      "name": "UPnP Device Description",
      "path": "/setup.xml",
      "response_body": {
        "content_type": "text/xml",
        "fields": [
          {
            "description": "UPnP device type URN used for variant matching.",
            "name": "deviceType",
            "type": "string"
          },
          {
            "description": "User-facing name. Do not use as the stable device key.",
            "name": "friendlyName",
            "type": "string"
          },
          {
            "description": "Primary stable identity, for example uuid:Socket-1_0-<serial>.",
            "name": "UDN",
            "type": "string"
          },
          {
            "description": "Secondary stable identity.",
            "name": "serialNumber",
            "type": "string"
          },
          {
            "description": "Tertiary stable identity.",
            "name": "macAddress",
            "type": "string"
          },
          {
            "description": "UPnP services with serviceType, controlURL, eventSubURL, and SCPDURL.",
            "name": "serviceList",
            "type": "array"
          }
        ]
      }
    },
    {
      "description": "Universal SOAP action for relay/light on/off. Required SOAPACTION header: \"urn:Belkin:service:basicevent:1#SetBinaryState\". Dimmers may include a brightness argument from 1-100 in the same action.\n",
      "method": "POST",
      "name": "SetBinaryState",
      "path": "/upnp/control/basicevent1",
      "request_body": {
        "content_type": "text/xml",
        "fields": [
          {
            "description": "Target state: 1 = on, 0 = off.",
            "enum": [
              0,
              1
            ],
            "name": "BinaryState",
            "required": true,
            "type": "integer"
          },
          {
            "description": "Optional dimmer brightness, 1-100.",
            "name": "brightness",
            "type": "integer"
          }
        ]
      }
    },
    {
      "description": "Universal SOAP action for current binary state. Required SOAPACTION header: \"urn:Belkin:service:basicevent:1#GetBinaryState\".\n",
      "method": "POST",
      "name": "GetBinaryState",
      "path": "/upnp/control/basicevent1",
      "response_body": {
        "content_type": "text/xml",
        "fields": [
