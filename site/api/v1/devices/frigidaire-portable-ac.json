{
  "device": {
    "identification": {
      "mdns_service_type": "_http._tcp",
      "ssid_prefix": "Frigidaire_"
    },
    "manufacturer": "Frigidaire (Electrolux)",
    "manufacturer_status": "unsupported",
    "name": "Frigidaire WiFi Portable Air Conditioner",
    "notes": "WiFi-connected portable AC units controlled via the Frigidaire app (Electrolux platform). Covers FHPC series (8K BTU) and FHPH series (13K BTU). Same cloud platform as window AC units but adds Dehumidify mode and drain-full indicator. Protocol details are hypothesized from public app features — APK analysis and network captures are needed to confirm endpoints, authentication, and payload formats.\n",
    "protocol": "wifi"
  },
  "entities": [
    {
      "commands": {
        "set_fan_mode": "set_fan_speed",
        "set_hvac_mode": "set_mode",
        "set_temperature": "set_temperature",
        "turn_off": "set_power_off",
        "turn_on": "set_power_on"
      },
      "features": [
        "target_temperature",
        "fan_mode",
        "hvac_mode"
      ],
      "name": "Portable Air Conditioner",
      "platform": "climate",
      "state_mapping": {
        "current_temperature": "current_temperature",
        "fan_mode": "fan_speed",
        "hvac_mode": "mode",
        "target_temperature": "target_temperature"
      },
      "state_topic": "appliance/{device_id}/state"
    },
    {
      "device_class": "temperature",
      "name": "Room Temperature",
      "platform": "sensor",
      "state_mapping": {
        "value": "current_temperature"
      },
      "state_topic": "appliance/{device_id}/state",
      "unit": "°F"
    },
    {
      "device_class": "problem",
      "name": "Filter Alert",
      "platform": "binary_sensor",
      "state_mapping": {
        "value": "filter_alert"
      },
      "state_topic": "appliance/{device_id}/state"
    },
    {
      "device_class": "problem",
      "name": "Drain Full",
      "platform": "binary_sensor",
      "state_mapping": {
        "value": "drain_full"
      },
      "state_topic": "appliance/{device_id}/state"
    },
    {
      "commands": {
        "turn_off": "set_sleep_off",
        "turn_on": "set_sleep_on"
      },
      "name": "Sleep Mode",
      "platform": "switch",
      "state_mapping": {
        "value": "sleep_mode"
      },
      "state_topic": "appliance/{device_id}/state"
    },
    {
      "commands": {
        "turn_off": "set_display_off",
        "turn_on": "set_display_on"
      },
      "name": "Display",
      "platform": "switch",
      "state_mapping": {
        "value": "display"
      },
      "state_topic": "appliance/{device_id}/state"
    }
  ],
  "mqtt_topics": [
    {
      "description": "Send control commands to the portable AC (power, mode, temp, fan, etc.).",
      "direction": "publish",
      "name": "Device Command",
      "payload_format": {
        "encoding": "json",
        "fields": [
          {
            "description": "Command name (e.g. set_power, set_mode, set_temperature, set_fan_speed).",
            "name": "command",
            "type": "string"
          },
          {
            "description": "Command value.",
            "name": "value",
            "type": "string"
          }
        ]
      },
      "qos": 1,
      "topic": "appliance/{device_id}/command"
    },
    {
      "description": "Receive current device state including portable-specific fields.",
      "direction": "subscribe",
      "name": "Device State",
      "payload_format": {
        "encoding": "json",
        "fields": [
          {
            "description": "Power state: on / off.",
            "name": "power",
            "type": "string"
          },
          {
            "description": "Operating mode: cool / eco / fan_only / dehumidify.",
            "name": "mode",
            "type": "string"
          },
          {
            "description": "Target temperature in °F (60-90).",
            "name": "target_temperature",
            "type": "integer"
          },
          {
            "description": "Current room temperature in °F.",
            "name": "current_temperature",
            "type": "integer"
          },
          {
            "description": "Fan speed: auto / low / medium / high.",
            "name": "fan_speed",
            "type": "string"
          },
          {
            "description": "Timer remaining in hours (0 = off).",
            "name": "timer_hours",
            "type": "number"
          },
          {
            "description": "Sleep mode: on / off.",
            "name": "sleep_mode",
            "type": "string"
          },
          {
            "description": "Filter status: ok / needs_cleaning.",
            "name": "filter_alert",
            "type": "string"
          },
          {
            "description": "Display state: on / off.",
            "name": "display",
            "type": "string"
          },
          {
            "description": "Drain tank status: ok / full (portable-specific).",
            "name": "drain_full",
            "type": "string"
          }
        ]
      },
      "qos": 1,
      "topic": "appliance/{device_id}/state"
    }
  ]
}
